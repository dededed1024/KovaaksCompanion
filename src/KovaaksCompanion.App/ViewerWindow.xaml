<Window x:Class="KovaaksCompanion.App.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:KovaaksCompanion.App"
        Title="KovaaK's Companion" Width="1320" Height="800" MinWidth="960" MinHeight="600" Background="{StaticResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Sessions -->
        <Grid Background="{StaticResource Panel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Sessions" Style="{StaticResource LargeTitle}" Margin="24,28,24,16"/>
            <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     SelectionChanged="OnSessionSelected" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="#B3FFFFFF" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Player -->
        <Grid Grid.Column="1" Margin="24,24,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="14" Background="Black" ClipToBounds="True">
                <Grid>
                    <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                  Stretch="Uniform" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
                    <app:TrailOverlay x:Name="Overlay" IsHitTestVisible="False"/>
                    <TextBlock x:Name="Notice" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Dim}"
                               FontSize="15" Text="Select a session"/>
                </Grid>
            </Border>

            <!-- Chart card: shares x axis with the seek bar below -->
            <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="14" Background="{StaticResource Panel}" Padding="20,16,20,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="84"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Accuracy" Foreground="{StaticResource Dim}" FontSize="12" Margin="6,0,6,0"/>
                            <TextBlock x:Name="AccText" FontWeight="SemiBold" FontSize="13" MinWidth="200"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeText" HorizontalAlignment="Right" Foreground="{StaticResource Dim}" FontSize="12"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <app:RunChart x:Name="Chart"/>
                        <Canvas x:Name="Markers" IsHitTestVisible="False" SizeChanged="OnMarkersResized"/>
                    </Grid>
                </Grid>
            </Border>

            <Slider Grid.Row="2" x:Name="Seek" Margin="16,8,16,0" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                    PreviewMouseLeftButtonDown="OnSeekDown" PreviewMouseLeftButtonUp="OnSeekUp" ValueChanged="OnSeekChanged"/>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PlayBtn" Content="Play" Width="88" Style="{StaticResource Primary}" Click="OnPlayPause"/>
                    <Button Content="&#x2039; 1f" Click="OnStepBack" ToolTip="Step back 1/60 s"/>
                    <Button Content="1f &#x203A;" Click="OnStepForward" ToolTip="Step forward 1/60 s"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Style="{StaticResource SegmentTrack}">
                    <StackPanel x:Name="SpeedBar" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="0.25x" Tag="0.25" Checked="OnSpeedChecked"/>
                        <RadioButton Style="{StaticResource Segment}" Content="0.5x" Tag="0.5" Checked="OnSpeedChecked"/>
                        <RadioButton Style="{StaticResource Segment}" Content="1x" Tag="1" IsChecked="True" Checked="OnSpeedChecked"/>
                        <RadioButton Style="{StaticResource Segment}" Content="1.5x" Tag="1.5" Checked="OnSpeedChecked"/>
                        <RadioButton Style="{StaticResource Segment}" Content="2x" Tag="2" Checked="OnSpeedChecked"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Stats -->
        <Grid Grid.Column="2" Background="{StaticResource Panel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatsText" Margin="24,28,24,16" TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource Dim}"/>
            <TextBlock Grid.Row="1" Text="Kills" Style="{StaticResource Headline}" Margin="24,8,24,8"/>
            <ListView x:Name="Kills" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="12,0,12,12"
                      Foreground="{StaticResource Fg}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" DisplayMemberBinding="{Binding Index}" Width="36"/>
                        <GridViewColumn Header="TTK" DisplayMemberBinding="{Binding Ttk}" Width="64"/>
                        <GridViewColumn Header="Flick" DisplayMemberBinding="{Binding Flick}" Width="64"/>
                        <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="64"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
