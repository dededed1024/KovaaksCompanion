<UserControl x:Class="KovaaksCompanion.App.StatsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:KovaaksCompanion.App"
        SizeChanged="OnViewSized" Typography.NumeralAlignment="Tabular"
        >
    <UserControl.Resources>
        <Style x:Key="PopupClose" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Home: the whole page -->
        <ScrollViewer x:Name="HomeScroll" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="32,0,32,0" Margin="0,0,8,0">
            <StackPanel>
                <!-- Profile card: laid out at one fixed design size (23:9); the Viewbox scales everything in it together like a single image. -->
                <Viewbox x:Name="ProfileBox" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <Grid Width="1753">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="ProfileTools" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                        <Border x:Name="ProfileCard" Grid.Row="1" Width="1753" Height="686" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="0" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Edge}" BorderThickness="0">
                            <Grid x:Name="ProfileHost" Margin="14,14,14,12"/>
                        </Border>
                        <Border x:Name="CelebrationCard" Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="8,16,8,8" CornerRadius="18" BorderThickness="1" Visibility="Collapsed">
                            <UniformGrid x:Name="CelebrationHost" Columns="1"/>
                        </Border>
                    </Grid>
                </Viewbox>
                <Grid x:Name="HomeHost" HorizontalAlignment="Center" Margin="0,24,0,24"/>
            </StackPanel>
        </ScrollViewer>
        <!-- Scroll edge under the title bar -->
        <Border Height="48" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource BgFadeColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource BgClearColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Floating jump-to-live pill -->
        <Border x:Name="LivePill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="14,7,12,7" CornerRadius="16" Background="{DynamicResource Red}"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Cursor="Hand" MouseLeftButtonUp="OnLivePill">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LivePillDot" Width="7" Height="7" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="LIVE" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Floating back-to-top button -->
        <Border x:Name="TopButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,24" Width="40" Height="40" CornerRadius="20" app:Grain.Card="True" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Edge}" BorderThickness="1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Cursor="Hand" MouseLeftButtonUp="OnTopButton"
                ToolTip="{app:Loc 'To top'}">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/></Border.Effect>
            <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Profile card editor popup: below the playlist detail popup so a clicked card opens on top -->
        <Grid x:Name="EditPopup" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnEditKey">
            <Border x:Name="EditScrim" Background="{DynamicResource Scrim}" Opacity="0" MouseLeftButtonDown="OnEditScrim"/>
            <Border x:Name="EditCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1200" Margin="48,72,48,48" CornerRadius="18" app:Grain.Card="True" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Edge}" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="EditScale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
                <Grid Margin="28,20,28,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="EditScroll" Grid.Row="1" Focusable="False" Margin="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"/>
                </Grid>
            </Border>
        </Grid>
        <!-- Playlist popup: scrim + card below the title bar -->
        <Grid x:Name="Popup" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnPopupKey">
            <Border x:Name="Scrim" Background="{DynamicResource Scrim}" Opacity="0" MouseLeftButtonDown="OnScrim"/>
            <Border x:Name="PopupCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="56,64,56,32" CornerRadius="18" app:Grain.Card="True" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Edge}" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
                <Grid x:Name="Detail" Margin="8,18,8,6">
                    <ScrollViewer x:Name="PlaylistScroll" Focusable="False" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel x:Name="Body" HorizontalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DiffTrack" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SegmentTrack}" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel x:Name="DiffBar" Orientation="Horizontal"/>
                                </Border>
                                <WrapPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Border x:Name="HeadPill" Width="10" Height="10" CornerRadius="5" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <TextBlock x:Name="Heading" Style="{StaticResource LargeTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button x:Name="Star" Content="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Background="Transparent" Padding="10,0" Margin="6,0,0,0"
                                                MinHeight="36" MinWidth="36" VerticalAlignment="Center" ToolTip="{app:Loc 'Favorite'}" Click="OnStarClick" Visibility="Collapsed"/>
                                        <Button x:Name="CopyImage" Content="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Background="Transparent" Padding="10,0" Margin="0"
                                                MinHeight="36" MinWidth="36" VerticalAlignment="Center" ToolTip="{app:Loc 'Copy scenarios as image'}" Click="OnCopyImageClick" Visibility="Collapsed"/>
                                        <Button x:Name="Pin" Content="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Background="Transparent" Padding="10,0" Margin="0"
                                                MinHeight="36" MinWidth="36" VerticalAlignment="Center" ToolTip="{app:Loc 'Show tier on Home'}" Click="OnPinClick" Visibility="Collapsed"/>
                                        <TextBlock x:Name="HeadMark" FontSize="14" FontWeight="ExtraBold" Opacity="0.6" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <Border x:Name="CodeChip" Background="{DynamicResource Wash}" CornerRadius="8" Padding="10,5" Margin="14,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="{app:Loc 'Copy sharecode'}" MouseLeftButtonUp="OnCodeClick" Visibility="Collapsed">
                                            <TextBlock x:Name="CodeText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Dim}"/>
                                        </Border>
                                        <Button x:Name="PlayList" Content="{app:Loc 'Play'}" Style="{StaticResource Primary}" MinHeight="30" Padding="14,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                ToolTip="{app:Loc 'Start in KovaaK\'s'}" Click="OnPlayListClick" Visibility="Collapsed"/>
                                    </WrapPanel>
                            </Grid>
                            <TextBlock x:Name="Summary" Margin="0,12,0,8" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Dim}"/>
                            <Grid x:Name="PageHost" Margin="0,12,0,12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Search popup: scrim + command-palette card near the top -->
        <Grid x:Name="SearchPopup" Visibility="Collapsed" PreviewKeyDown="OnSearchKey">
            <Border x:Name="SearchScrim" Background="{DynamicResource Scrim}" Opacity="0" MouseLeftButtonDown="OnSearchScrim"/>
            <Border x:Name="SearchCard" Width="640" MaxWidth="1200" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="48,72,48,48" CornerRadius="18" app:Grain.Card="True" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Edge}" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="SearchScale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
                <StackPanel>
                    <TextBox x:Name="SearchBox" Tag="Search playlists and scenarios" Margin="16" TextChanged="OnSearchChanged"/>
                    <ScrollViewer x:Name="SearchScroll" Focusable="False" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" Visibility="Collapsed" Margin="0,0,0,10"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Session popup: scrim + card centered on screen -->
        <Grid x:Name="SessionPopup" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnSessionKey">
            <Border x:Name="SessionScrim" Background="{DynamicResource Scrim}" Opacity="0" MouseLeftButtonDown="OnSessionScrim"/>
            <Border x:Name="SessionCardBorder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="80,64,80,80" CornerRadius="18" app:Grain.Card="True" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Edge}" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="SessionScale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
                <Grid x:Name="SessionHost"/>
            </Border>
        </Grid>

        <!-- First sync: covers the page until every scenario's server scores are in -->
        <Border x:Name="SyncOverlay" Visibility="Collapsed" app:Grain.Card="True" Background="{DynamicResource Surface}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="SyncSpinHost" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SyncCount" HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="14" Foreground="{DynamicResource Dim}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
