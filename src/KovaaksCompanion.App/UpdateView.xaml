<UserControl x:Class="KovaaksCompanion.App.UpdateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:KovaaksCompanion.App"
        Visibility="Collapsed">
    <Grid>
        <Border x:Name="Scrim" Background="{DynamicResource Scrim}" Opacity="0" MouseLeftButtonDown="OnScrim"/>
        <Border x:Name="Card" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,0" CornerRadius="18" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Edge}" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
            <StackPanel Margin="32,28,32,28">
                <TextBlock Style="{StaticResource Title}" FontSize="22" Text="{app:Loc 'Update available'}"/>
                <TextBlock x:Name="Versions" Margin="0,8,0,0" Foreground="{DynamicResource Dim}"/>
                <ScrollViewer x:Name="NotesScroll" MaxHeight="260" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Notes" TextWrapping="Wrap" Foreground="{DynamicResource Dim}"/>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="LaterBtn" Content="{app:Loc 'Later'}" Click="OnLater"/>
                    <Button x:Name="UpdateBtn" Style="{StaticResource Primary}" Content="{app:Loc 'Update'}" Margin="8,0,0,0" Click="OnUpdate"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
