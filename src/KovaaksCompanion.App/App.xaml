<Application x:Class="KovaaksCompanion.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#16181D"/>
        <SolidColorBrush x:Key="Panel" Color="#1F232A"/>
        <SolidColorBrush x:Key="Fg" Color="#E6E8EB"/>
        <SolidColorBrush x:Key="Dim" Color="#8A93A0"/>
        <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Application.Resources>
</Application>
