<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KovaaksCompanion.Core\KovaaksCompanion.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.3.4</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.otf" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Bundled ffmpeg: fetched (pinned, hash-checked) by scripts/fetch-ffmpeg.ps1, embedded, unpacked at runtime by FfmpegBundle. A build without it fails. -->
  <Target Name="EmbedFfmpeg" BeforeTargets="AssignTargetPaths;CreateManifestResourceNames">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\fetch-ffmpeg.ps1&quot;" ContinueOnError="true" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\ffmpeg\ffmpeg.exe')" Text="ffmpeg\ffmpeg.exe is missing and scripts/fetch-ffmpeg.ps1 could not fetch it; the app must embed ffmpeg." />
    <ItemGroup>
      <EmbeddedResource Include="ffmpeg\ffmpeg.exe" LogicalName="ffmpeg.exe" />
    </ItemGroup>
  </Target>

</Project>
