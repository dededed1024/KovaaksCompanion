<Window x:Class="KovaaksCompanion.App.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:KovaaksCompanion.App"
        Title="KovaaK's Companion - Stats" Width="1200" Height="780" MinWidth="900" MinHeight="560" Background="{StaticResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Browser -->
        <Grid Background="{StaticResource Panel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Stats" Style="{StaticResource LargeTitle}" Margin="24,28,24,16"/>
            <Border Grid.Row="1" Margin="16,0,16,12" Style="{StaticResource SegmentTrack}">
                <StackPanel x:Name="ModeBar" Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <RadioButton Style="{StaticResource Segment}" Content="Playlists" Tag="Playlists" IsChecked="True" Checked="OnModeChecked"/>
                    <RadioButton Style="{StaticResource Segment}" Content="Scenarios" Tag="Scenarios" Checked="OnModeChecked"/>
                    <RadioButton Style="{StaticResource Segment}" Content="Categories" Tag="Categories" Checked="OnModeChecked"/>
                </StackPanel>
            </Border>
            <TextBox x:Name="Search" Grid.Row="2" Margin="16,0,16,12" TextChanged="OnSearchChanged"/>
            <ListBox x:Name="List" Grid.Row="3" Background="Transparent" BorderThickness="0"
                     SelectionChanged="OnItemSelected" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="#B3FFFFFF" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Detail -->
        <Grid Grid.Column="1" Margin="32,28,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="Heading" Style="{StaticResource LargeTitle}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,8,0,18" TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource Dim}"/>
            <Border Grid.Row="2" CornerRadius="14" Background="{StaticResource Panel}" Padding="20,16,20,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ChartTitle" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <app:ScoreChart x:Name="Chart" Grid.Row="1"/>
                </Grid>
            </Border>
            <ListView x:Name="Rows" Grid.Row="3" Margin="0,20,0,0" Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource Fg}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="OnRowDoubleClick">
                <ListView.View>
                    <GridView x:Name="RowsView"/>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
