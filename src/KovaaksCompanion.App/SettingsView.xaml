<UserControl x:Class="KovaaksCompanion.App.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:KovaaksCompanion.App"
        Visibility="Collapsed" SizeChanged="OnSized">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,14,0,-4"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="OpacityMask">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="White" Offset="0.2"/>
                        <GradientStop Color="Transparent" Offset="0.95"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource Tint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeFaint}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ColDivider" TargetType="Border">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource EdgeFaint}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="SheetClose" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="Scrim" Background="{DynamicResource Scrim}" Opacity="0" MouseLeftButtonDown="OnScrim"/>
        <Border x:Name="Card" MaxWidth="1200" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="48,48,48,0" CornerRadius="18" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Edge}" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
            <Border x:Name="Clipper" CornerRadius="17" SizeChanged="OnCardSized">
                <Grid Margin="28,24,10,28">
                    <ScrollViewer x:Name="PageScroll" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock x:Name="LockNote" Text="{app:Loc 'KovaaK\'s must be closed to change settings'}" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="4,14,0,-4" Visibility="Collapsed"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{app:Loc Appearance}"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel x:Name="AppearanceSection">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource ColDivider}" Grid.RowSpan="2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{app:Loc Language}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                    <Border Grid.Column="1" Width="260" Style="{StaticResource SegmentTrack}">
                                        <UniformGrid x:Name="LanguageBar" Rows="1"/>
                                    </Border>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{app:Loc 'UI size'}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                    <Border Grid.Column="1" Width="340" Style="{StaticResource SegmentTrack}">
                                        <UniformGrid x:Name="ScaleBar" Rows="1">
                                            <RadioButton Style="{StaticResource Segment}" Content="75%" Tag="75" Checked="OnAppearance"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="90%" Tag="90" Checked="OnAppearance"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="100%" Tag="100" Checked="OnAppearance"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="110%" Tag="110" Checked="OnAppearance"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="125%" Tag="125" Checked="OnAppearance"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="150%" Tag="150" Checked="OnAppearance"/>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{app:Loc Theme}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                    <WrapPanel x:Name="ThemeBar" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="{app:Loc 'Recording'}"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel x:Name="RecordingSection">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ColDivider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{app:Loc 'Recording quality'}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                    <Border Grid.Column="1" Width="300" Style="{StaticResource SegmentTrack}">
                                        <UniformGrid x:Name="QualityBar" Rows="1">
                                            <RadioButton Style="{StaticResource Segment}" Content="{app:Loc 'Low'}" Tag="Low" Checked="OnQuality"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="{app:Loc 'Medium'}" Tag="Medium" Checked="OnQuality"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="{app:Loc 'High'}" Tag="High" Checked="OnQuality"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="{app:Loc 'Ultra'}" Tag="Ultra" Checked="OnQuality"/>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                        <TextBlock Text="{app:Loc 'Max FPS'}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                        <TextBox Grid.Column="1" x:Name="FpsBox" Width="100" MaxLength="4" TextChanged="Validate" LostFocus="OnCommit" KeyDown="OnTextKey" PreviewTextInput="OnDigits"/>
                                    </Grid>
                                    <TextBlock x:Name="FpsError" Foreground="{DynamicResource Red}" FontSize="12" Margin="4,4,0,0" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="{app:Loc 'Storage'}"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel x:Name="StorageSection">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ColDivider}"/>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                        <TextBlock Text="{app:Loc 'Max storage (0 GB = unlimited)'}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                        <TextBox Grid.Column="1" x:Name="StorageBox" Width="100" MaxLength="8" TextChanged="Validate" GotKeyboardFocus="OnStorageFocus" LostFocus="OnStorageLostFocus" KeyDown="OnTextKey" PreviewTextInput="OnDigits"/>
                                    </Grid>
                                    <TextBlock x:Name="StorageError" Foreground="{DynamicResource Red}" FontSize="12" Margin="4,4,0,0" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{app:Loc 'Max age (0 days = unlimited)'}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                        <TextBox Grid.Column="1" x:Name="AgeBox" Width="100" MaxLength="5" TextChanged="Validate" GotKeyboardFocus="OnAgeFocus" LostFocus="OnAgeLostFocus" KeyDown="OnTextKey" PreviewTextInput="OnDigits"/>
                                    </Grid>
                                    <TextBlock x:Name="AgeError" Foreground="{DynamicResource Red}" FontSize="12" Margin="4,4,0,0" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{app:Loc 'Save video for PB only'}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,16,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnPbOnlyLabel"/>
                                    <CheckBox Grid.Column="1" x:Name="PbOnly" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnCommit" Unchecked="OnCommit"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{app:Loc 'Keep personal best replays'}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,16,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnKeepPbLabel"/>
                                    <CheckBox Grid.Column="1" x:Name="KeepPb" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnCommit" Unchecked="OnCommit"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                <TextBlock Text="{app:Loc 'Keep only the best run video in a session'}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,16,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnBeatenLabel"/>
                                <CheckBox Grid.Column="1" x:Name="DeleteBeaten" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnCommit" Unchecked="OnCommit"/>
                                </Grid>
                                </StackPanel>
                            </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="{app:Loc 'Webcam'}"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel x:Name="CamSection">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="CamDivider" Style="{StaticResource ColDivider}" Visibility="Collapsed"/>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{app:Loc 'Webcam'}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,0,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnCamLabel"/>
                                        <CheckBox Grid.Column="1" x:Name="CamOn" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnCamToggle" Unchecked="OnCamToggle"/>
                                    </Grid>
                                    <StackPanel x:Name="CamLeft" Visibility="Collapsed">
                                        <Border Width="240" Height="135" Margin="0,12,0,0" HorizontalAlignment="Center" CornerRadius="6" Background="{DynamicResource Panel}" ClipToBounds="True">
                                            <Canvas x:Name="CamCanvas"/>
                                        </Border>
                                        <TextBlock Text="{app:Loc 'How to save video'}" Foreground="{DynamicResource Fg}" Margin="4,16,0,4"/>
                                        <StackPanel x:Name="CamSaveBar" Margin="4,0,0,0">
                                            <RadioButton Style="{StaticResource Radio}" Content="{app:Loc 'One video (game + webcam)'}" Tag="Composite" Checked="OnCamSave"/>
                                            <RadioButton Style="{StaticResource Radio}" Content="{app:Loc 'Separate videos (game and webcam)'}" Tag="Separate" Checked="OnCamSave"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="CamPanel" Grid.Column="2" Visibility="Collapsed">
                                    <StackPanel x:Name="CamCards"/>
                                    <Button x:Name="CamAdd" Content="{app:Loc 'Add webcam'}" Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="OnCamAdd"/>
                                </StackPanel>
                            </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="{app:Loc 'General'}"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel x:Name="GeneralSection">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource ColDivider}" Grid.RowSpan="2"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="{app:Loc 'KovaaK\'s folder'}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                        <TextBox x:Name="Kovaaks" LostFocus="OnCommit" KeyDown="OnTextKey"/>
                                        <Button Grid.Column="1" Content="{app:Loc 'Browse…'}" Margin="8,0,0,0" Click="OnBrowseKovaaks"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Caption}" Text="{app:Loc 'Output folder'}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                        <TextBox x:Name="Data" LostFocus="OnCommit" KeyDown="OnTextKey"/>
                                        <Button Grid.Column="1" Content="{app:Loc 'Browse…'}" Margin="8,0,0,0" Click="OnBrowseData"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="{app:Loc 'Steam ID'}"/>
                                    <TextBox x:Name="Steam" TextChanged="Validate" LostFocus="OnCommit" KeyDown="OnTextKey"/>
                                    <TextBlock x:Name="SteamError" Foreground="{DynamicResource Red}" FontSize="12" Margin="4,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0" VerticalAlignment="Bottom">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                        <TextBlock Text="{app:Loc 'Start with Windows'}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,0,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnAutoStartLabel"/>
                                        <CheckBox Grid.Column="1" x:Name="AutoStart" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnAutoStart" Unchecked="OnAutoStart"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{app:Loc 'Send anonymous error reports automatically'}" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="4,0,0,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnErrorReportsLabel"/>
                                            <Border Width="18" Height="18" Margin="8,0,0,0" CornerRadius="9" BorderBrush="{DynamicResource Dim}" BorderThickness="1" Background="Transparent" Cursor="Help" VerticalAlignment="Center"
                                                    ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                                                <TextBlock Text="i" Foreground="{DynamicResource Dim}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border.ToolTip>
                                                    <StackPanel MaxWidth="420">
                                                        <TextBlock Text="{app:Loc 'Example of a sent report'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                                                   Text="**Error** v1.7.0 · replay media&#10;System.InvalidOperationException: Cannot play the file.&#10;   at KovaaksCompanion.App.ReplayView.OnMediaFailed(...)&#10;   at System.Windows.Media.MediaPlayer.OnMediaFailed(...)"/>
                                                        <TextBlock Text="{app:Loc 'Only the error type, message and stack trace are sent. Your user name and profile path are hidden.'}" Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" x:Name="ErrorReports" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnCommit" Unchecked="OnCommit"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="{app:Loc 'About'}"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ColDivider}"/>
                                <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="VersionCaption" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Button Grid.Column="1" x:Name="CheckBtn" Content="{app:Loc 'Check for updates'}" Click="OnCheckUpdate"/>
                            </Grid>
                                </StackPanel>
                                <StackPanel x:Name="ReportPanel" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center">
                                    <Button x:Name="ReportOpenBtn" Content="{app:Loc 'Report a bug'}" HorizontalAlignment="Right" Click="OnReportOpen"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,14,0,0">
                                <Run Text="{app:Loc 'Unofficial. Not affiliated with KovaaK Games.'}"/>
                                <LineBreak/>
                                <Run Text="{app:Loc 'Playlists from '}"/><Hyperlink NavigateUri="https://evxl.app" RequestNavigate="OnLink">evxl.app</Hyperlink><Run Text="{app:Loc ' (EviL).'}"/>
                                <LineBreak/>
                                <Run Text="{app:Loc 'Video by '}"/><Hyperlink NavigateUri="https://obsproject.com" RequestNavigate="OnLink">OBS Studio</Hyperlink><Run Text="{app:Loc ' (libobs, GPL v2, '}"/><Hyperlink NavigateUri="https://github.com/dededed1024/KovaaksCompanion/blob/main/THIRD-PARTY-NOTICES.md" RequestNavigate="OnLink">source and notices</Hyperlink><Run Text=")."/>
                            </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <Grid x:Name="ReportOverlay" Visibility="Collapsed">
            <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="OnReportCancel"/>
            <Border MaxWidth="480" Margin="48" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="18" Padding="20"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{app:Loc 'Report a bug'}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                    <TextBox x:Name="ReportText" Margin="0,14,0,0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxLength="1500" Padding="12,10"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="OnReportText"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,14,0,6"
                               Text="{app:Loc 'The following information is sent together with this report.'}"/>
                    <Border CornerRadius="12" Background="{DynamicResource Panel}" Padding="12,10">
                        <StackPanel>
                            <TextBlock x:Name="ReportInfo" FontSize="12" Foreground="{DynamicResource Dim}" TextWrapping="Wrap"/>
                            <StackPanel x:Name="ReportLogPanel" Margin="0,10,0,0">
                                <TextBlock Text="{app:Loc 'Application log (last 300 lines)'}" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                <ScrollViewer MaxHeight="110" Margin="0,4,0,0" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ReportLog" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Dim}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="{app:Loc 'Cancel'}" Margin="0,0,8,0" Click="OnReportCancel"/>
                        <Button x:Name="ReportBtn" Content="{app:Loc 'Send'}" IsEnabled="False" Click="OnReport"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
