<UserControl x:Class="KovaaksCompanion.App.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Visibility="Collapsed" SizeChanged="OnSized">
    <UserControl.Resources>
        <Style x:Key="SheetClose" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Selected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="Scrim" Background="#99000000" Opacity="0" MouseLeftButtonDown="OnScrim"/>
        <Border x:Name="Card" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,0" CornerRadius="18" Background="#F2232326"
                BorderBrush="#1FFFFFFF" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
            <Border x:Name="Clipper" CornerRadius="17" SizeChanged="OnCardSized">
                <Grid Margin="28,24,28,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Title}" FontSize="22" Text="Settings" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="KovaaK's folder"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="Kovaaks" LostFocus="OnCommit" KeyDown="OnTextKey"/>
                                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseKovaaks"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" Text="Data folder"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="Data" LostFocus="OnCommit" KeyDown="OnTextKey"/>
                                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseData"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" Text="Steam ID"/>
                            <TextBox x:Name="Steam" TextChanged="Validate" LostFocus="OnCommit" KeyDown="OnTextKey"/>
                            <TextBlock x:Name="SteamError" Foreground="{StaticResource Red}" FontSize="12" Margin="4,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Recording quality" Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                <Border Grid.Column="1" Width="300" Style="{StaticResource SegmentTrack}">
                                    <UniformGrid x:Name="QualityBar" Rows="1">
                                        <RadioButton Style="{StaticResource Segment}" Content="Low" Tag="Low" Checked="OnQuality"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Medium" Tag="Medium" Checked="OnQuality"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="High" Tag="High" Checked="OnQuality"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Ultra" Tag="Ultra" Checked="OnQuality"/>
                                    </UniformGrid>
                                </Border>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start with Windows" Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="4,0,0,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnAutoStartLabel"/>
                                <CheckBox Grid.Column="1" x:Name="AutoStart" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnAutoStart" Unchecked="OnAutoStart"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="VersionCaption" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Button Grid.Column="1" x:Name="CheckBtn" Content="Check for updates" Click="OnCheckUpdate"/>
                            </Grid>

                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,14,0,0">
                                <Run Text="Unofficial. Not affiliated with KovaaK Games."/>
                                <LineBreak/>
                                <Run Text="Playlists from "/><Hyperlink NavigateUri="https://evxl.app" RequestNavigate="OnLink">evxl.app</Hyperlink><Run Text=" (EviL)."/>
                                <LineBreak/>
                                <Run Text="Video by "/><Hyperlink NavigateUri="https://ffmpeg.org" RequestNavigate="OnLink">FFmpeg</Hyperlink><Run Text=" (LGPL v3, "/><Hyperlink NavigateUri="https://github.com/dededed1024/KovaaksCompanion/blob/main/THIRD-PARTY-NOTICES.md" RequestNavigate="OnLink">source and notices</Hyperlink><Run Text=")."/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
