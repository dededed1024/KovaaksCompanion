<UserControl x:Class="KovaaksCompanion.App.ReplayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:KovaaksCompanion.App"
        Visibility="Collapsed" Typography.NumeralAlignment="Tabular" SizeChanged="OnSized">
    <UserControl.Resources>
        <Style x:Key="SheetClose" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Wash}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource WashPress}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayerToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Wash}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Card}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SheetCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource Tint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeFaint}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="Scrim" Background="{DynamicResource Scrim}" Opacity="0" MouseLeftButtonDown="OnScrim"/>
        <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,0" CornerRadius="18" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Edge}" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
            <Border x:Name="Clipper" CornerRadius="17" SizeChanged="OnCardSized">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition x:Name="GapCol" Width="12"/>
                        <ColumnDefinition x:Name="SideCol" Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stage: scenario overview, or one run (stats strip + video + chart + transport) -->
                    <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="Header" Margin="2,0,0,12" SizeChanged="OnHeaderSized">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Heading" Style="{StaticResource Title}" FontSize="20" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="PlayScn" Grid.Column="1" Content="{app:Loc 'Play'}" Style="{StaticResource Primary}" MinHeight="30" Padding="14,0" Margin="12,0,0,0" VerticalAlignment="Center"
                                ToolTip="{app:Loc 'Start in KovaaK\'s'}" Click="OnPlayScenario" Visibility="Collapsed"/>
                        <StackPanel x:Name="HeaderTools" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ScnStar" Content="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Background="Transparent" Padding="10,0" Margin="6,0,0,0"
                                    MinHeight="30" MinWidth="30" VerticalAlignment="Center" ToolTip="{app:Loc 'Add to favorites'}" Click="OnScenarioStar" Visibility="Collapsed"/>
                            <Button x:Name="RunDelBtn" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Background="Transparent" ToolTip="{app:Loc 'Delete Recording'}" Click="OnDeleteRun" MouseLeave="OnDelLeave"
                                    MinHeight="30" MinWidth="30" Padding="10,0" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Button x:Name="FolderBtn" Content="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Background="Transparent" ToolTip="{app:Loc 'Show video file in Explorer'}" Click="OnShowVideo"
                                    MinHeight="30" MinWidth="30" Padding="10,0" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="OverviewScroll" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="OverviewHost"/>
                        </ScrollViewer>

                        <Grid x:Name="RunPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="Stage" Grid.Row="1" Margin="0" SizeChanged="OnStageSized">
                                <Border x:Name="Screen" CornerRadius="14" Background="Black" ClipToBounds="True" MouseLeftButtonDown="OnScreenDown">
                                    <Grid>
                                        <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                                      Stretch="Uniform" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
                                        <app:TrailOverlay x:Name="Overlay" IsHitTestVisible="False"/>
                                        <Border x:Name="PendingHost" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <TextBlock x:Name="Notice" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Dim}"
                                                   FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="24" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border x:Name="BarScrim" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" Margin="0,-48,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#D9000000" Offset="0.45"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Run chart: stats as series; shares its x axis with the seek bar below -->
                            <Border x:Name="ChartCard" Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource SheetCard}" Padding="16,12,16,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition x:Name="RunChartRow" Height="110"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl x:Name="Metrics" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Chip}" Cursor="Hand" Padding="8,2" Margin="0,0,4,0" CornerRadius="8" Opacity="{Binding Opacity}" MouseLeftButtonUp="OnMetricClick">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Dim}" FontSize="12.5" Margin="8,0,8,0"/>
                                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="13" MinWidth="30"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="PrevChip" Style="{StaticResource Chip}" Cursor="Hand" Padding="8,4" Margin="12,0,0,0" CornerRadius="8" Visibility="Collapsed"
                                                    ToolTip="{app:Loc 'Overlay the previous local play'}" MouseLeftButtonUp="OnPrevClick">
                                                <TextBlock x:Name="PrevText" Text="{app:Loc 'Prev play'}" Foreground="{DynamicResource Dim}" FontSize="12.5"/>
                                            </Border>                                        </StackPanel>
                                    </Grid>
                                    <app:RunChart x:Name="Chart" Grid.Row="1" Margin="0,6,0,0" Cursor="Hand" MouseLeftButtonDown="OnChartDown" MouseMove="OnChartMove" MouseLeftButtonUp="OnChartUp"/>
                                </Grid>
                            </Border>

                            <Grid x:Name="TransportBar" Grid.Row="4" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ToggleButton x:Name="TrailBtn" Content="{app:Loc 'Trail'}" Style="{StaticResource PlayerToggle}" ToolTip="{app:Loc 'Show or hide the trail (T)'}" Click="OnTrailClick"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#x2039; 1f" Style="{StaticResource PlayerButton}" Click="OnStepBack" ToolTip="{app:Loc 'Step back 1/60 s (←)'}"/>
                                    <Button x:Name="PlayBtn" Content="&#xE768;" FontSize="20" Width="40" Height="40" Style="{StaticResource PlayerButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{app:Loc 'Play / pause (Space)'}" Click="OnPlayPause"/>
                                    <Button Content="1f &#x203A;" Style="{StaticResource PlayerButton}" Click="OnStepForward" ToolTip="{app:Loc 'Step forward 1/60 s (→)'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TimeReadout" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Dim}">
                                        <Run x:Name="TimeNow" Foreground="{DynamicResource Fg}" Text="0:00"/><Run Text=" / "/><Run x:Name="TimeTotal" Text="0:00"/>
                                    </TextBlock>
                                    <Button x:Name="SpeedBtn" Content="1x" Style="{StaticResource PlayerButton}" MinWidth="48" ToolTip="{app:Loc 'Playback speed'}" Click="OnSpeedClick"/>
                                    <Popup x:Name="SpeedPop" PlacementTarget="{Binding ElementName=SpeedBtn}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Margin="10,10,10,6" Padding="4" CornerRadius="10" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Edge}" BorderThickness="1">
                                            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
                                            <StackPanel x:Name="SpeedMenu"/>
                                        </Border>
                                    </Popup>
                                    <Button x:Name="FsBtn" Content="&#xE740;" FontSize="16" Width="40" Style="{StaticResource PlayerButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{app:Loc 'Fullscreen (F)'}" Click="OnFsClick"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                    </Grid>

                    <!-- Sidebar: run list -->
                    <Grid x:Name="Side" Grid.Column="2">
                        <Border Style="{StaticResource SheetCard}" Background="{DynamicResource Tint}" ClipToBounds="True">
                            <Grid>
                                <ScrollViewer x:Name="RunsScroll" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="6,6,6,6">
                                        <StackPanel x:Name="RunsHost"/>
                                        <Button x:Name="MoreBtn" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,2" Padding="8,0,8,0" MinHeight="26" Background="Transparent"
                                                Foreground="{DynamicResource Accent}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Click="OnMore"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock x:Name="NoRuns" Text="{app:Loc 'No local plays yet'}" Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
